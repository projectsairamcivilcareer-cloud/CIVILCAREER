            {
              "code": "DC",
              "title": "Basic Structural Analysis",
              "kind": "Theory",
              "credits": 2,
              "topics": [
                {
                  "title": "Unit I — Analysis of Perfect Frames",
                  "items": [
                    "Types of frames: perfect, imperfect and redundant pin-jointed plane frames.",
                    "Analysis of determinate pin-jointed plane frames by method of joints, method of sections and tension coefficient method for vertical, horizontal and inclined loads."
                  ]
                },
                {
                  "title": "Unit II — Energy Theorems and Three-Hinged Arches",
                  "items": [
                    "Strain energy in linear elastic systems due to axial load, bending moment and shear force.",
                    "Castigliano’s theorem and unit-load method; deflections of simple beams, pin-jointed plane frames and statically determinate bent frames.",
                    "Three-hinged and two-hinged arches; linear arch and Eddy’s theorem; analysis of three-hinged arches for normal thrust, radial shear and bending moment.",
                    "Geometrical properties of parabolic and circular arches; three-hinged arches with supports at different levels."
                  ]
                },
                {
                  "title": "Unit III — Propped Cantilever and Fixed Beams",
                  "items": [
                    "Static and kinematic indeterminacy of beams.",
                    "Analysis of propped cantilever and fixed beams with constant or varying moment of inertia under UDL, point loads, UVL, couples and combinations.",
                    "Shear-force and bending-moment diagrams, elastic curve and deflection; effects of support settlement and support rotation."
                  ]
                },
                {
                  "title": "Unit IV — Continuous Beams and Slope-Deflection Method",
                  "items": [
                    "Clapeyron’s theorem of three moments; continuous beams with constant and variable moment of inertia, fixed ends, overhangs and support settlement.",
                    "Derivation and application of slope-deflection equations to continuous beams with and without support settlement.",
                    "Static and kinematic indeterminacy of frames; single-bay, single-storey portal frames including sidesway; SFD, BMD and elastic curve."
                  ]
                },
                {
                  "title": "Unit V — Moving Loads and Influence Lines",
                  "items": [
                    "Maximum shear force and bending moment at a section and absolute maximum values due to concentrated loads, UDLs longer or shorter than the span, two point loads at fixed spacing and multiple point loads.",
                    "Equivalent uniformly distributed load and focal length.",
                    "Influence lines for shear force and bending moment; load positions for maximum SF and BM under point loads and UDLs."
                  ]
                }
              ]
            },
